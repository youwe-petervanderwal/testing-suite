parameters:
  # See https://phpstan.org/user-guide/ignoring-errors#excluding-whole-files
  excludePaths:
    # Symfony files
    - bin/console
    - public/index.php
    # Full var folder, contains all kind of auto-generated files (e.g. cache, generated Pimcore DataObject classes)
    - var
    # Configuration written by Pimcore (which is written either to var/ or to config/pimcore/ depending on settings)
    - config/pimcore
    # Youwe Deployer configuration
    - build/deployer
    # Unit tests
    - tests/fixtures
    # Add project specific excludes below
